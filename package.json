		"bootstrap": "^5.3.8",
		"idb": "^8.0.3",
		"jszip": "^3.10.1",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@fullhuman/postcss-purgecss": "^8.0.0",
		"@types/node": "^26.4.1",
		"prettier": "3.9.6",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-solid": "^2.11.14"
	}
}